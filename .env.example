# Скопируйте этот файл в .env в корне проекта:
#   copy .env.example .env
# Ключи только сюда, не в код и не в браузер.

# Чат LeadBot через Gemini. Без ключа работает mock.
# Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Telegram-бот для заявок с сайта.
# 1. В Telegram откройте @BotFather → /newbot → скопируйте токен.
# 2. Напишите боту любое сообщение (или добавьте его в группу).
# 3. Узнайте chat id (после сообщения боту):
#    npm run telegram:chat-id
#    npm run telegram:chat-id -- --write   ← записать id в .env
#    Или вручную: https://api.telegram.org/bot<ТОКЕН>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательный вебхук CRM, если заявку ещё куда-то слать.
CRM_WEBHOOK_URL=
